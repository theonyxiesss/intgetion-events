{
  "name": "@intgetion/events",
  "version": "0.1.0",
  "description": "Tech events for INTGETION JOB LIST: conferences and meetups imported from approved sources (confs.tech, ccfddl), the event catalog, search filters and JSON-LD.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/modules/events/service/index.ts",
    "./config": "./src/config/events.ts",
    "./server": "./src/server/app.ts",
    "./db": "./src/db/owned.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@intgetion/kit": "github:theonyxiesss/intgetion-kit#v0.3.1",
    "drizzle-orm": "^0.45.3",
    "pino": "10.4.0",
    "postgres": "^3.4.9",
    "tsx": "^4.20.0",
    "zod": "^4.6.5",
    "@intgetion/ingestion": "github:theonyxiesss/intgetion-ingestion#v0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
